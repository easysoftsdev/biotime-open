# ─── Application ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=biotime
POSTGRES_USER=biotime
POSTGRES_PASSWORD=change-me-strong-password

# ─── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=redispass
REDIS_URL=redis://:redispass@redis:6379/0
CELERY_BROKER_URL=redis://:redispass@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redispass@redis:6379/2

# ─── MinIO / S3 ───────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_BIOPHOTOS=biophotos
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_BACKUPS=backups
MINIO_USE_SSL=false

# ─── JWT Auth ─────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── First Admin ──────────────────────────────────────────────
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin@123456

# ─── Device Settings ──────────────────────────────────────────
DEVICE_OFFLINE_THRESHOLD_SECONDS=300
DEVICE_SYNC_RETRY_MAX=3

# ─── HRM Push ─────────────────────────────────────────────────
HRM_PUSH_MAX_RETRIES=5
HRM_PUSH_TIMEOUT_SECONDS=30

# ─── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
